  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"{App,index}.ts{,x}\" \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"{App,index}.ts{,x}\" \"src/**/*.{ts,tsx}\"",
    "export:android": "expo export --platform android"
