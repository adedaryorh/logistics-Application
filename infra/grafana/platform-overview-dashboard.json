{
  "title": "Platform Overview",
  "schemaVersion": 39,
  "tags": ["logistics-platform", "slo"],
  "panels": [
    {
      "title": "Request Rate",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(http_requests_total[5m])) by (service)"
        }
      ]
    },
    {
      "title": "Error Rate",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{status=~\"5..\"}[5m])) by (service)"
        }
      ]
    },
    {
      "title": "Latency P99",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket[5m])) by (le, service))"
        }
      ]
    },
    {
      "title": "Async Publish Failures",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(service_outbox_events_total{status!=\"published\"}[5m])) by (service, status)"
        }
      ]
    },
    {
      "title": "Kafka Producer Success",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(kafka_producer_messages_total{status=\"success\"}[5m])) by (topic)"
        }
      ]
    },
    {
      "title": "Redis Error Rate",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(redis_client_requests_total{status=\"failed\"}[5m])) by (command)"
        }
      ]
    },
    {
      "title": "Tracing Coverage",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(http_requests_traced_total[5m])) by (service)"
        }
      ]
    }
  ]
}
